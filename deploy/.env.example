# Optional notes for operators. Compose does not require secrets here —
# Basic Auth lives in QuickDish deploy/nginx/.htpasswd-family (gitignored).

# Subdomain (DNS A record → VPS IP):
# FAMILY_HOST=ai-eos.it

# Backend defaults (set in docker-compose-prod.yml):
# NODE_ENV=production
# PORT=3000
# DATABASE_PATH=/data/transactions.db
