{
  "name": "cost-tracking-family-server",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/tax/rules && cp src/tax/rules/*.json dist/tax/rules/",
